# SQLite database file, stored outside the public web directory.
TREVY_DB_PATH=/var/data/trevy.sqlite

# Private upload directory. Keep it outside the public web directory.
TREVY_UPLOAD_DIR=/var/data/trevy-uploads

# Public HTTPS origin used for provider return URLs and webhook setup.
TREVY_PUBLIC_URL=https://your-domain.example.com

# Generate a random 32-byte key and encode it as base64 (or 64 hex chars).
# Required before saving payment secrets; never commit a real key.
TREVY_ENCRYPTION_KEY=

# Required for production bootstrap (password minimum 14 characters).
TREVY_ADMIN_EMAIL=
TREVY_ADMIN_PASSWORD=
